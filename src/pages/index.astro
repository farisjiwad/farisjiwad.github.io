---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout>
	<Navbar />
	<main id="main">
		<section class="about-section shell" id="about" aria-labelledby="about-title">
			<p class="eyebrow">Computer science research</p>
			<h1 id="about-title">About <span>me.</span></h1>
			<p class="intro">I'm Faris Jiwad, a computer science researcher interested in the systems, intelligence, and people shaping our computational future.</p>
			<p>Research often starts with a connection between disciplines, a practical problem and an overlooked question, or what we know and what we still need to understand. This is a home for the ideas, tools, and questions I'm exploring.</p>
			<a class="text-link" href="mailto:farisjiwad@gmail.com">Get in touch <span aria-hidden="true">↗</span></a>
		</section>

		<section class="section shell" id="research" aria-labelledby="research-title">
			<div class="section-heading">
				<div><p class="eyebrow">Research</p><h2 id="research-title">Areas of Interest</h2></div>
				<p>From foundational systems to intelligent technologies and the people who use them.</p>
			</div>
			<div class="interest-grid">
				<article class="interest-card"><h3>Systems &amp; operating systems</h3><p>How we design and understand the infrastructure that computation depends on.</p></article>
				<article class="interest-card"><h3>Autonomous systems</h3><p>How computational systems perceive, reason, and act in changing environments.</p></article>
				<article class="interest-card"><h3>Artificial intelligence &amp; machine learning</h3><p>Exploring the capabilities, limitations, and design of intelligent systems.</p></article>
				<article class="interest-card"><h3>Human-computer interaction</h3><p>How people and computing technologies meet, influence, and support one another.</p></article>
			</div>
		</section>

		<section class="section shell" id="projects" aria-labelledby="projects-title">
			<div class="section-heading">
				<div><p class="eyebrow">Projects</p><h2 id="projects-title">Built Applications</h2></div>
				<p>Tools for a more thoughtful research process.</p>
			</div>
			<article class="project-card">
				<div>
					<p class="project-label">Research tool</p>
					<h3>Research Radar</h3>
					<p>A discovery tool for exploring recent computer science papers, collecting a reading shortlist, and following evidence-backed leads.</p>
					<p class="project-caveat">Abstract-based signals are starting points, not verified research gaps.</p>
					<div class="project-actions">
						<a class="button" href="https://farisjiwad.github.io/research-radar/">Open Research Radar <span aria-hidden="true">↗</span></a>
						<a class="text-link" href="https://github.com/farisjiwad/research-radar">View source <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<div class="radar-art" aria-hidden="true"><span></span></div>
			</article>
		</section>
	</main>
	<Footer />
</Layout>
